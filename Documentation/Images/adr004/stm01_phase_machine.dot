digraph STM01 {
  graph [rankdir=TB, fontname="Helvetica", fontsize=11, label="STM-01  Hyades FC-V4 flight phase machine (phase.c k_allowed, detect.c, flight.c arbiter)  —  8 Nov 2026", labelloc=t, nodesep=0.5, ranksep=0.55];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, fillcolor="#eef3fb", color="#4a6fa5"];
  edge  [fontname="Helvetica", fontsize=9, color="#333333"];
  BOOT [label="BOOT\nreset; drivers up"];
  CAL  [label="CALIBRATE\ngyro bias (1 s), IEKF seed"];
  SET  [label="SETTLING\nIEKF converging; hold timer\nfins OFF (flight build)"];
  READY[label="READY\nall monitors pass for READY_HOLD\nlog ring ARMED (2.56 s)", fillcolor="#e6f5e6", color="#3b8a3b"];
  BOOST[label="BOOST\nroll law FULL / RDAMP\nlog COMMITTED", fillcolor="#fff4e0", color="#c07a00"];
  COAST[label="COAST\nroll law FULL / RDAMP", fillcolor="#fff4e0", color="#c07a00"];
  DESC [label="DESCENT\nfins OFF; GPS aiding", fillcolor="#fff4e0", color="#c07a00"];
  LAND [label="LANDED\nlog closes after 60 s\n(terminal)", fillcolor="#e8e8e8"];
  LOCK [label="LOCKOUT\nlatched; pad only\n(exit: operator 'faults clear')", fillcolor="#fde8e8", color="#b03030"];
  CATO [label="CATO_SAFE\nlatched in flight; fins OFF", fillcolor="#fde8e8", color="#b03030"];
  BOOT -> CAL  [label="boot ok"];
  BOOT -> LOCK [label="IMU init / self-test fail", color="#b03030", fontcolor="#b03030"];
  CAL  -> SET  [label="seeded"];
  CAL  -> LOCK [label="IWDG reset cause", color="#b03030", fontcolor="#b03030"];
  SET  -> READY[label="worst = INFO for READY_HOLD\n& log space ok (flight build)"];
  READY-> SET  [label="any SOFT fault\n(not while liftoff pending)", style=dashed];
  READY-> BOOST[label="LIFTOFF: f_ax > 3 g for 100 ms & v_up > 8 m/s\nor f_ax > 3 g for 300 ms", penwidth=2];
  SET  -> BOOST[label="LIFTOFF (same rule)\nSTM-01 F3", style=dashed, color="#c07a00", fontcolor="#c07a00"];
  BOOST-> COAST[label="BURNOUT: t >= 0.1 s & f_ax < 0 for 50 ms"];
  COAST-> DESC [label="APOGEE: v_up < 0 for 50 ms (nav valid)\nor t_coast >= 11.5 s"];
  DESC -> LAND [label="GPS: quiet & |v| < 1.5 m/s for 2 s\nor shock > 3 g then still 2 s\nor still 30 s; or t >= 300 s\n(t >= 15 s; runs despite HARD)"];
  CATO -> LAND [label="same landing rules\nSTM-01 F2", color="#b03030", fontcolor="#b03030"];
  SET  -> LOCK [label="HARD", color="#b03030", fontcolor="#b03030"];
  READY-> LOCK [label="HARD", color="#b03030", fontcolor="#b03030"];
  BOOST-> CATO [label="HARD", color="#b03030", fontcolor="#b03030"];
  COAST-> CATO [label="HARD", color="#b03030", fontcolor="#b03030"];
  LOCK -> SET  [label="operator clear (pad, no HARD active)", style=dotted];
  {rank=same; LOCK; READY}
  {rank=same; CATO; COAST}
}
